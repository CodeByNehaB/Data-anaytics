## Chart revenue share by segment
rev = rfm.groupby("Segment")["Monetary"].sum().reindex(order)
rev_pct = (rev / rev.sum() * 100).round(1)

plt.figure(figsize=(9, 5))
bars = plt.bar(rev_pct.index, rev_pct.values, color="#FFDA1A", edgecolor="#0058A3")

for bar in bars:
