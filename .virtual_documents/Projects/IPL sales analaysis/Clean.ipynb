mismatch = df[df['runs_total'] != (df['runs_batter'] + df['runs_extras'])]
print("\nRows where runs_total != runs_batter + runs_extras:", len(mismatch))



print("\nOver/ball range:")
print("  over: min=", df['over'].min(), "max=", df['over'].max())
print("  ball: min=", df['ball'].min(), "max=", df['ball'].max())

print("\nInnings value counts:")
print(df['innings'].value_counts().sort_index())


print("\nMax wickets in any single innings (should never exceed 10):")
max_wkts = df.groupby(['match_id','innings'])['team_wicket'].max()
print("  overall max:", max_wkts.max())
print("  innings exceeding 10:", (max_wkts > 10).sum())


print("\nBatting position range:")
print("  bat_pos: min=", df['bat_pos'].min(), "max=", df['bat_pos'].max())
print("  non_striker_pos: min=", df['non_striker_pos'].min(), "max=", df['non_striker_pos'].max())



