    print(f"  {col}:", sorted(df[col].unique()))





import pandas as pd
import os
import shutil


# set up the folder structure
os.makedirs("data/raw", exist_ok= True)
os.makedirs("data/processed", exist_ok=True)


#point this at wherever your original csv currently lives

source_file = "IPL_Dataset_2008_to_2026.csv"
raw_path="data/raw/IPL_Dataset_2008_to_2026.csv"


#cpoy it into data/ raw once, if it isn't already there

if not os.path.exists(raw_path):
    shutil.copy(source_file, raw_path)

# Load from data/raw/ — this exact file is never modified from here on
df_raw = pd.read_csv(raw_path, low_memory=False)


# Make an explicit working copy — this is the one we'll actually clean
df = df_raw.copy()


print("Raw file shape:", df_raw.shape)
print("Working copy shape:", df.shape)

print("\n--- BEFORE CLEANING ---")
print("Rows:", df.shape[0])
print("Columns:", df.shape[1])
print("Missing values (total):", df.isnull().sum().sum())
print("Duplicate rows:", df.duplicated().sum())





#Create a single, clean, numeric season identifier that removes the two-format


# 'year' is 100% consistent within each season (verified earlier) —
# so the clean version already exists, no string parsing needed

df['season_clean'] = df['year']

# Should give exactly 19 unique values: 2008 through 2026, no gaps
print("Unique season_clean values:", sorted(df['season_clean'].unique()))
print("count:", df['season_clean'].nunique())


# Confirm every original season label still maps to exactly one season_clean value

mapping = df.groupby('season')['season_clean'].unique()
print("\nOriginal season -> season_clean mapping:")
for season_label, years in mapping.items():
    print(f" {season_label!r} -> {years}")





# Map each old franchise name to its current name —
# using current branding as the canonical identity for all-time analysis


team_rebrand_name={
    "Delhi Daredevils":"Delhi Capitals",
    "Kings XI Punjab": "Punjab Kings",
    "Royal Challengers Bangalore":"Royal Challengers Bengaluru",
    "Rising Pune Supergaints":"Rising Pune Supergaint",
}

df['batting_team_clean'] = df['batting_team'].replace(team_rebrand_name)
df['bowling_team_clean'] = df['bowling_team'].replace(team_rebrand_name)

# Should drop from 19 raw names to 15 canonical franchises
teams_before = set(df['batting_team'].unique()) | set(df['bowling_team'].unique())
teams_after = set(df['batting_team_clean'].unique()) | set(df['bowling_team_clean'].unique())
print("Teams before:", len(teams_before))
print("Teams after:", len(teams_after))


print()
for old, new in team_rebrand_name.items():
    print(f"{old} -> {new}: old name gone = {old not in teams_after}, new name present = {new in teams_after}")





venue_map = {
    "Arun Jaitley Stadium, Delhi": "Arun Jaitley Stadium",
    "Feroz Shah Kotla": "Arun Jaitley Stadium",
    "Brabourne Stadium, Mumbai": "Brabourne Stadium",
    "Dr DY Patil Sports Academy, Mumbai": "Dr DY Patil Sports Academy",
    "Dr. Y.S. Rajasekhara Reddy ACA-VDCA Cricket Stadium, Visakhapatnam": "Dr. Y.S. Rajasekhara Reddy ACA-VDCA Cricket Stadium",
    "Eden Gardens, Kolkata": "Eden Gardens",
    "Himachal Pradesh Cricket Association Stadium, Dharamsala": "Himachal Pradesh Cricket Association Stadium",
    "M Chinnaswamy Stadium, Bengaluru": "M Chinnaswamy Stadium",
    "M.Chinnaswamy Stadium": "M Chinnaswamy Stadium",
    "MA Chidambaram Stadium, Chepauk": "MA Chidambaram Stadium",
    "MA Chidambaram Stadium, Chepauk, Chennai": "MA Chidambaram Stadium",
    "Maharaja Yadavindra Singh International Cricket Stadium, New Chandigarh": "Maharaja Yadavindra Singh International Cricket Stadium, Mullanpur",
    "Maharashtra Cricket Association Stadium, Pune": "Maharashtra Cricket Association Stadium",
    "Sardar Patel Stadium, Motera": "Narendra Modi Stadium, Ahmedabad",
    "Punjab Cricket Association IS Bindra Stadium, Mohali": "Punjab Cricket Association IS Bindra Stadium",
    "Punjab Cricket Association IS Bindra Stadium, Mohali, Chandigarh": "Punjab Cricket Association IS Bindra Stadium",
    "Punjab Cricket Association Stadium, Mohali": "Punjab Cricket Association IS Bindra Stadium",
    "Rajiv Gandhi International Stadium, Uppal": "Rajiv Gandhi International Stadium",
    "Rajiv Gandhi International Stadium, Uppal, Hyderabad": "Rajiv Gandhi International Stadium",
    "Sawai Mansingh Stadium, Jaipur": "Sawai Mansingh Stadium",
    "Shaheed Veer Narayan Singh International Stadium, Raipur": "Shaheed Veer Narayan Singh International Stadium",
    "Wankhede Stadium, Mumbai": "Wankhede Stadium",
}

df['venue_clean'] = df['venue'].replace(venue_map)

print("Venues before:", df['venue'].nunique())
print("Venues after:", df['venue_clean'].nunique())

print("\nFinal canonical venue list:")
for v in sorted(df['venue_clean'].unique()):
    print(" -", v)





# Bangalore -> Bengaluru (current name; also resolves the M Chinnaswamy split automatically)
df['city_clean'] = df['city'].replace({"Bangalore": "Bengaluru"})

# 'Unknown' -> the venue's own real city (the correct value already exists in the data)
df.loc[(df['venue_clean'] == "Dubai International Cricket Stadium") & (df['city_clean'] == 'Unknown'), 'city_clean'] = "Dubai"
df.loc[(df['venue_clean'] == "Sharjah Cricket Stadium") & (df['city_clean'] == 'Unknown'), 'city_clean'] = "Sharjah"

# The two remaining either-way calls, resolved by whichever label is more common for that venue
df.loc[df['venue_clean'] == "Dr DY Patil Sports Academy", 'city_clean'] = "Mumbai"
df.loc[df['venue_clean'] == "Maharaja Yadavindra Singh International Cricket Stadium, Mullanpur", 'city_clean'] = "Mohali"

print("Cities before:", df['city'].nunique())
print("Cities after:", df['city_clean'].nunique())
print("'Unknown' remaining:", (df['city_clean'] == 'Unknown').sum())

# Re-check: does every venue now map to exactly one city?
recheck = df.groupby('venue_clean')['city_clean'].nunique()
print("Venues still mapping to more than one city:", (recheck > 1).sum())





import re
import numpy as np

def parse_win_outcome(value):
    if pd.isnull(value):
        return np.nan, np.nan
    match = re.match(r'(\d+)\s+(runs|wickets)', str(value))
    if match:
        return int(match.group(1)), match.group(2)
    return np.nan, np.nan

parsed = df['win_outcome'].apply(lambda x: pd.Series(parse_win_outcome(x), index=['win_margin', 'win_type']))
df['win_margin'] = parsed['win_margin']
df['win_type'] = parsed['win_type']


# Label the 25 previously-missing matches with WHY, instead of a silent blank
super_over_matches = [392190, 419121, 598004, 598017, 729315, 829741, 1082625, 1175365,
                       1178426, 1216493, 1216512, 1216517, 1216547, 1254077, 1473469, 1529281]
no_result_matches = [501265, 829763, 1359519, 1473492, 1473495, 1527685, 829813, 1178424, 1473481]

df.loc[df['match_id'].isin(super_over_matches), 'win_type'] = 'Tied (Super Over)'
df.loc[df['match_id'].isin(no_result_matches), 'win_type'] = 'No Result'

print("Row-level win_type breakdown:")
print(df['win_type'].value_counts(dropna=False))


print("\nMatch-level win_type breakdown (more meaningful than row counts):")
print(df.groupby('match_id')['win_type'].first().value_counts())

print("\nwin_margin range by type:")
print(df[df['win_type'].isin(['runs', 'wickets'])].groupby('win_type')['win_margin'].agg(['min', 'max', 'mean']))





# AFTER cleaning
after_rows, after_cols = df.shape
after_missing = df.isnull().sum().sum()
after_dupes = df.duplicated().sum()



# BEFORE, straight from df_raw (still untouched since Step 7) - no hardcoded numbers
before_rows, before_cols = df_raw.shape
before_missing = df_raw.isnull().sum().sum()
before_dupes = df_raw.duplicated().sum()


comparison = pd.DataFrame({
    "Before": [before_rows, before_cols, before_missing, before_dupes],
    "After": [after_rows, after_cols, after_missing, after_dupes]
}, index=["Rows", "Columns", "Missing values", "Duplicate rows"])
print(comparison)


new_columns = [c for c in df.columns if c not in df_raw.columns]
print("\nNew columns added during cleaning:", new_columns)



# Save - this never touches data/raw/
cleaned_path = "data/processed/IPL_Dataset_Cleaned.csv"
df.to_csv(cleaned_path, index=False)
print(f"\nSaved to {cleaned_path}")


# Reload to actually confirm the save worked, not just assume it did
reloaded = pd.read_csv(cleaned_path, low_memory=False)
print("Reloaded shape:", reloaded.shape)



