def plot_close_match_pct(team_stats, save_path=None):
    plt.figure(figsize=(10, 7))

    # Sort data and reset index
    data = team_stats.sort_values("pct_close", ascending=False).reset_index()

    # If the index column didn't get named 'team', rename the first column to 'team'
    if "team" not in data.columns:
        data = data.rename(columns={data.columns[0]: "team"})

    # Create the horizontal bar plot
    sns.barplot(
        data=data,
        y="team",
        x="pct_close",
        hue="team",
        palette="magma",
        legend=False,
    )

    # Labeling and styling
    plt.xlabel("% of Matches That Were Close (<=10 runs or <=1 wicket)")
    plt.ylabel("")
    plt.title("Which Teams Play the Most Nail-Biters")
    plt.tight_layout()

    if save_path:
        plt.savefig(save_path, dpi=150)
    else:
        plt.show()


