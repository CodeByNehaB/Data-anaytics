def plot_venue_toss_advantage(qualified, save_path=None):
    plt.figure(figsize=(10, 7))
    data = qualified.reset_index()
    colors = ['firebrick' if v < 0 else 'seagreen' for v in data['field_advantage']]
    plt.barh(data['venue'], data['field_advantage'], color=colors)
    plt.axvline(0, color='black', linewidth=0.8)
    plt.xlabel('Field-First Advantage (percentage points)')
    plt.title('Does Fielding First Help, by Venue?')
    plt.tight_layout()
    if save_path:
        plt.savefig(save_path, dpi=150)
    else:
        plt.show()

