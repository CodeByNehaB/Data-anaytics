    plt.axhline(50, color='grey', linestyle='--', linewidth=1, label='50% (even)')
    plt.xlabel('Season')
    plt.ylabel('Chasing Team Win %')
    plt.title('Chase Success Rate by Season')
    plt.legend()
    plt.tight_layout()
    if save_path:
        plt.savefig(save_path, dpi=150)
    else:
        plt.show()

