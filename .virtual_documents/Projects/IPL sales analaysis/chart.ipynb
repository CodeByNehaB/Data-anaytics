    plt.ylabel('%')
    plt.title('Toss Advantage and Strategy Over 19 IPL Seasons')
    plt.legend()
    plt.tight_layout()
    if save_path:
        plt.savefig(save_path, dpi=150)
    else:
        plt.show()

