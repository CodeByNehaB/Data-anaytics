def plot_team_run_diff(team_profile, save_path=None):
    plt.figure(figsize=(10, 8))
    data = team_profile.reset_index()
    colors = ['seagreen' if v >= 0 else 'firebrick' for v in data['run_diff']]
    plt.barh(data['batting_team'], data['run_diff'], color=colors)
    plt.axvline(0, color='black', linewidth=0.8)
    plt.xlabel('Run Differential per Innings (scored - conceded)')
    plt.title('IPL Team Run Differential')
    plt.tight_layout()
    if save_path:
        plt.savefig(save_path, dpi=150)
    else:
        plt.show()

