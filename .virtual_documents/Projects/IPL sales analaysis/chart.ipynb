def plot_season_overview(overview_df, save_path=None):
    fig, axes = plt.subplots(2, 1, figsize=(12, 8), sharex=True)
    axes[0].bar(overview_df.index, overview_df['matches'], color='steelblue')
    axes[0].set_ylabel('Matches Played')
    axes[0].set_title('Matches by Season')
    axes[1].plot(overview_df.index, overview_df['avg_wickets_per_innings'], marker='o', color='darkred')
    axes[1].set_ylabel('Avg Wickets per Innings')
    axes[1].set_xlabel('Season')
    axes[1].set_title('Wicket-Loss Rate by Season')
    plt.tight_layout()
    if save_path:
        plt.savefig(save_path, dpi=150)
    else:
        plt.show()

