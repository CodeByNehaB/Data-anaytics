





import pandas as pd
import matplotlib.pyplot as plt

summary = pd.read_csv('team_win_summary.csv', index_col=0)
top_scorers = pd.read_csv('top_scores.csv', index_col=0).iloc[:,0]


summary_sorted = summary.sort_values('win_pct', ascending=False)
plt.figure(figsize=(12,6))
plt.bar(summary_sorted.index, summary_sorted['win_pct'])
plt.title("IPL Team Win Percentage (2008-2026)")
plt.xlabel("Team")
plt.ylabel("Win percentage")
plt.xticks(rotation=75, ha='right')
plt.grid(True, axis='y', alpha=0.3)
plt.tight_layout()
plt.show()


type(top_scorers)
top_scorers.head()


### Chart 2 top 10 run scorers

top_10 = top_scorers.head(10)


plt.figure(figsize=(10,6))
plt.bar(top_10.index, top_10.values, color='darkorange')
plt.title("Top 10 Run Scorers in IPL History")
plt.xlabel("Player")
plt.ylabel("Total Career runs")
plt.xticks(rotation=45, ha='right')
plt.tight_layout()
plt.show()





decided_pct = pd.read_csv('toss_decision_by_year.csv', index_col=0)

plt.figure(figsize=(10, 5))
plt.plot(decided_pct.index, decided_pct['field'], marker='o', color='green')
plt.title('Toss Decision Trend: % Choosing to Field First (2008–2026)')
plt.xlabel('Season')
plt.ylabel('% of toss winners choosing to field')
plt.ylim(0, 100)
plt.grid(True, alpha=0.3)
plt.show()





home_away = pd.read_csv('home_away_win_pct.csv', index_col=0)

x = range(len(home_away))
width = 0.35

plt.figure(figsize=(14, 6))
plt.bar([i - width/2 for i in x], home_away['home_win_pct'], width, label='Home win %', color='steelblue')
plt.bar([i + width/2 for i in x], home_away['away_win_pct'], width, label='Away win %', color='salmon')
plt.xticks(list(x), home_away.index, rotation=75, ha='right')
plt.title('Home vs Away Win Percentage by Team')
plt.ylabel('Win percentage')
plt.legend()
plt.grid(True, axis='y', alpha=0.3)
plt.tight_layout()
plt.show()





wickets_top10 = pd.read_csv('top_wickets.csv', index_col=0).iloc[:, 0].head(10)

plt.figure(figsize=(10, 6))
plt.bar(wickets_top10.index, wickets_top10.values, color='seagreen')
plt.title('Top 10 Wicket-Takers in IPL History')
plt.ylabel('Total wickets')
plt.xticks(rotation=45, ha='right')
plt.grid(True, axis='y', alpha=0.3)
plt.tight_layout()
plt.show()





avg_by_year = pd.read_csv('avg_score_by_year.csv', index_col=0).iloc[:, 0]

plt.figure(figsize=(10, 5))
plt.plot(avg_by_year.index, avg_by_year.values, marker='o', color='crimson')
plt.title('Average IPL Innings Score by Season (2008–2026)')
plt.xlabel('Season')
plt.ylabel('Average runs per innings')
plt.grid(True, alpha=0.3)
plt.show()


