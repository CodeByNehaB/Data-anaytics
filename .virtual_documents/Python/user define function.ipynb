#Wap to calcuate the electricity bill

def electricity(n):
    if n<=500:
        print("Your bill is Rs", n*5)
    elif n >500 and n<=700:
        print("Your bill is Rs", n*10)
    elif n>700 and n<=1000:
        print("your bill is Rs", n*15)
    else:
        print("your bill is Rs", n*20)

        


