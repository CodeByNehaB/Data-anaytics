








### Execute code only if only the given condition is true

age = int(input("Enter your age"))

if age>= 18:
    print("You are eligible for driving the Vehicle")





### The else statement execute the block of code if the condition in if statement is false

Age = int(input("Enter your age"))

if Age >= 18:
    print("Your are eligible for vote")
else:
    print("You are minor")






### Elif allow you to check multiple condtions. It's stand for "else-if".

Age = int(input("Enter your age"))

if Age <=13:
    print("You are a child")
elif Age < 18:
    print("You are a teenager")
else:
    print("You are a adult")





### You can place conditional blocks inside other conditional blocks to evaluate multi-layered rules

num = int(input("Enter your Number"))

if num > 0:
    print("The number is positive")
    if num %2 ==0:
        print("The number is Even")
    else:
        print("The number is odd")
else:
    print("The number is Zero or Negetive")





### Determine the this year is leap year or not
year = int(input("Enter your year"))

if year %4 ==0:
    if year % 100== 0:
        if year %400 ==0:
            print(f"{year} is leap year")
        else:
            print(f"{year} is not a leap year")
    else:
        print(f"{year} is a leap year")
else:
    print(f"{year} is not a leap year")






