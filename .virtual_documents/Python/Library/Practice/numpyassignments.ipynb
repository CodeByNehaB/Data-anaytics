import numpy as np

# Create a 3x3 2D array filled with random integers from 1 to 10
matrix_2d = np.random.randint(1, 11, size=(3, 3))

# Create a 1D array of shape (3,)
array_1d = np.array([10, 20, 30])

# Add the 1D array to each row of the 2D array via broadcasting
result = matrix_2d + array_1d

print("Original 2D Matrix (3, 3):\n", matrix_2d)
print("\n1D Array to Add (3,):\n", array_1d)
print("\nResulting Matrix (3, 3):\n", result)



