num = int(input("Enter your number"))

is_prime = True

if num <=1:
    is_prime = False
else:
    for i in range(2, num):
        if num% i ==0:
            is_prime = False
            break

if is_prime:
    print(f"{num} is prime")
else:
    print(f"{num} is not prime")








def fib( n:int)->int:
    if(n <0):
         return -1
    if(n==0 or n==1):
        return n
    return fib(n-1)+fib(n-2)

n = int(input("Enter your number"))

result =fib(n)
print(result)



