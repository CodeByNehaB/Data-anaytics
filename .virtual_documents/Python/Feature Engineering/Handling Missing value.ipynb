df = sns.load_dataset('titanic')
df


df.head()


## check misiing vlaue

df.isnull().sum()



### delete the rows or data ointd to habdle missing vale
df.shape


df.dropna().shape


## columns wise deleteuion

df.dropna(axis=1)





